# ============================================================
# .env.polymarket — Polymarket CLOB credentials
# ============================================================
# Rename this file to .env.polymarket and fill in your values.
# NEVER commit the real file to git.
#
# HOW TO GET THESE VALUES:
#
# 1. POLYMARKET_PRIVATE_KEY
#    - Go to https://reveal.polymarket.com while logged in
#    - It will show your private key (the signing key)
#    - Or export from MetaMask if you use an EOA wallet
#
# 2. POLYMARKET_FUNDER
#    - This is your Polymarket deposit address (proxy wallet)
#    - Visible in your Polymarket profile dropdown (top right)
#    - This is where your USDC lives on Polygon
#
# 3. POLYMARKET_SIGNATURE_TYPE
#    - 0 = EOA (MetaMask direct, no proxy)
#    - 1 = Email / Magic wallet
#    - 2 = Browser wallet (MetaMask via Polymarket proxy)
#    - Most users who log in with MetaMask on polymarket.com → use 2
#
# 4. POLYMARKET_CHAIN_ID
#    - Always 137 (Polygon mainnet)
# ============================================================

POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER=
POLYMARKET_SIGNATURE_TYPE=2
POLYMARKET_CHAIN_ID=137
