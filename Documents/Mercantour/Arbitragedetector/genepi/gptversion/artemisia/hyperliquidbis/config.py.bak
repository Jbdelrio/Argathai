"""
Artemisia Glacialis v5b — SCALPING Config
Frequent small trades: 15-40 trades/day, TP 0.15-0.30%, hold 1-5 min.
"""
from dataclasses import dataclass, field
from datetime import datetime, timezone
from typing import List, Optional, Dict
import json, pathlib

BTC_GENESIS = datetime(2009, 1, 3, tzinfo=timezone.utc)
PL_SLOPE = 5.82; PL_INTERCEPT = -17.01; PL_BAND = 0.30

@dataclass
class Config:
    # ── Polling & Candles ───────────────────
    tick_interval_ms: int = 2000
    candle_seconds: int = 60
    warmup_candles: int = 20          # 20min warmup (faster!)
    max_candle_history: int = 120

    # ── Strategy Toggles ────────────────────
    enable_ema: bool = True           # EMA crossover scalper
    enable_rsi: bool = True           # RSI overbought/oversold
    enable_vwap: bool = True          # VWAP bounce

    # ── EMA Crossover ───────────────────────
    ema_fast: int = 8                 # EMA(5)
    ema_slow: int = 34                # EMA(15)
    ema_atr_mult: float = 0.5        # edge = ATR × 0.8

    # ── RSI ──────────────────────────────────
    rsi_period: int = 14
    rsi_oversold: float = 28        # < 28 → long
    rsi_overbought: float = 78      # > 72 → short

    # ── VWAP Bounce ─────────────────────────
    vwap_period: int = 30             # SMA(20) as VWAP proxy
    vwap_max_dist: float = 0.004     # max 0.3% from VWAP to be a "bounce"
    vwap_atr_mult: float = 0.5       # edge = ATR × 0.7

    # ── SIZING & LEVERAGE ───────────────────
    initial_capital: float = 500.0
    max_leverage: float = 8.0
    min_leverage: float = 3.0
    base_position_pct: float = 0.06   # 6% per trade
    max_simultaneous: int = 3

    # ── STOPS (tight for scalping!) ─────────
    stop_pct: float = 0.004           # 0.30% stop
    tp_pct: float = 0.001             # 0.20% take profit
    breakeven_after_candles: int = 3

    # ── Max Hold ────────────────────────────
    ema_hold_candles: int = 3         # EMA: 5 min max
    rsi_hold_candles: int = 5         # RSI: 3 min max
    vwap_hold_candles: int = 6        # VWAP: 4 min max

    # ── FEES ────────────────────────────────
    maker_fee: float = 0.00016
    taker_fee: float = 0.00035
    use_maker: bool = True
    slippage_bps: float = 0.8
    min_edge_bps: float = 5.0         # LOW: only need 5bp above fees

    # ── COOLDOWN ────────────────────────────
    cooldown_candles: int = 1          # 1 candle = 1min between trades
    cooldown_after_loss: int = 2       # 2 candles after loss
    max_trades_per_symbol_hour: int = 8

    # ── UNIVERSE ────────────────────────────
    hl_info_url: str = "https://api.hyperliquid.xyz/info"
    min_daily_volume: float = 5_000_000
    max_universe_size: int = 12
    preferred_symbols: List[str] = field(default_factory=lambda: [
        "BTC", "ETH", "SOL", "DOGE", "XRP", "SUI",
        "AVAX", "LINK", "PEPE", "WIF", "ARB", "OP"
    ])
    universe_filter: List[str] = field(default_factory=list)

    # ── Power Law ───────────────────────────
    power_law_enabled: bool = True
    pl_long_zone: float = -0.10
    pl_neutral_zone: float = 0.10

    # ── Dashboard ───────────────────────────
    dash_port: int = 8054
    max_log_display: int = 200

    # ── Ticker compat ───────────────────────
    mr_fast_window: int = 5
    mr_slow_window: int = 15
    sp_window: int = 20
    mb_btc_window: int = 8
    max_tick_history: int = 1000

    # BB compat (not used but ticker references)
    bb_period: int = 20
    bb_std: float = 2.0
    bb_squeeze_pctile: float = 20.0
    mom_lookback: int = 5

    @property
    def fee_rate(self):
        return self.maker_fee if self.use_maker else self.taker_fee

    def roundtrip_cost_bps(self):
        return (self.fee_rate * 2 + self.slippage_bps / 10000 * 2) * 10000

    def to_dict(self):
        return {k: v for k, v in self.__dict__.items()}

    def save(self, path="g5_config.json"):
        with open(path, "w") as f:
            json.dump(self.to_dict(), f, indent=2)

    @classmethod
    def load(cls, path="g5_config.json"):
        p = pathlib.Path(path)
        if not p.exists(): return cls()
        with open(path) as f: data = json.load(f)
        c = cls()
        for k, v in data.items():
            if hasattr(c, k): setattr(c, k, v)
        return c

@dataclass
class Candle:
    timestamp: datetime
    open: float; high: float; low: float; close: float
    n_ticks: int = 0

@dataclass
class Position:
    symbol: str; side: str; strategy: str
    entry_price: float; entry_time: datetime; entry_candle: int
    size_usd: float; leverage: float
    stop_loss: float; take_profit: float
    breakeven_activated: bool = False
    pnl: float = 0.0; pnl_pct: float = 0.0; fees_paid: float = 0.0
    status: str = "open"
    exit_price: float = 0.0; exit_time: Optional[datetime] = None
    exit_candle: int = 0; exit_reason: str = ""; hold_candles: int = 0

@dataclass
class Signal:
    timestamp: datetime; candle_num: int
    symbol: str; side: str; strategy: str
    edge_bps: float; raw_edge_bps: float
    leverage: float; reason: str
    meta: Dict = field(default_factory=dict)
